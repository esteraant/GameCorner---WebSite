<header>
        <nav id="meniu-principal">
            <label for="ch-menu" id="hamburger">
                <div class="container-hamburger">
                    <span class="bara"></span>
                    <span class="bara"></span>
                    <span class="bara"></span>
                </div>
            </label>
            
            <input type="checkbox" id="ch-menu" style="display:none;">

            <ul class="meniu">
                <li>
                    <a href="/">
                        <i class="fa-solid fa-bounce fa-house"></i> 
                        <span class="text-meniu">Acasă</span>
                    </a>
                </li>

                <li class="container-submeniu">
                    <span class="nume-meniu">
                        <i class="fa-solid fa-images"></i> 
                        <span class="text-meniu">Galerii</span>
                    </span>

                    <ul class="submeniu">
                        <li><a href="/galerie-Statica"> Galerie Statică</a></li>
                        <li><a href="/galerie-dinamica"> Galerie Dinamică</a></li>
                    </ul>
                </li>

                <li class="container-submeniu">
                    <div class="nume-meniu">
                        <i class="fa-solid fa-dice"></i> 
                        <span class="text-meniu">Produse</span>
                    </div>
                    <ul class="submeniu">
                        <li><a href="/produse">Toate</a></li>
                            <% for(let opt of locals.optiuni) { %>
                                <li>
                                    <!-- cream linkul catre pagina de produse -->
                                    <a href="/produse?tip=<%- opt.nume_categorie %>">
                                        <%- opt.nume_categorie %>
                                    </a>
                                </li>
                            <% } %>
                    </ul>
                </li>

                
                <li><a href="/despre">
                    <i class="fa-solid fa-circle-info"></i> 
                        <span class="text-meniu">Despre noi</span>
                    </a> 
                </li> 

                <li><a href="/contact">
                    <i class="fa-solid fa-envelope"></i> 
                        <span class="text-meniu">Contact</span>
                    </a> 
                </li> 
           
            </ul>
          
            
        </nav>

        

        <section id="banner">
            <picture>
                <source srcset="/resurse/imagini/banner700x400.jpg" media="(max-width:700px)">
                <source srcset="/resurse/imagini/banner1200.jpg" media="(max-width:1200px)">
                <img src="/resurse/imagini/bannerMAX.jpg" alt="Banner">
            </picture>

            
            <div class="banner-text">
                <h1 id="inceput-pagina">GameCorner</h1>
                
            </div>
        </section>

        <div class="container-switch-tema text-end my-3">
            <div class="form-check form-switch d-inline-flex align-items-center gap-2 p-2 rounded shadow-sm zona-selector-tema">
                <input class="form-check-input m-0" type="checkbox" role="switch" id="switch-tema" style="cursor: pointer; transform: scale(1.25);">
                <label class="form-check-label" for="switch-tema" style="cursor: pointer;">
                    <i id="icon-tema" class="fa-solid fa-sun text-warning fs-5"></i>
                </label>
            </div>
        </div>
        
    </header>
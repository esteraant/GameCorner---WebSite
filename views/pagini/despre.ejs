<!DOCTYPE html>
<html lang="ro">

<head>
    <title>GameCorner - despre</title>
    <meta name="description" content="Despre magazinul Gamecorner">
    <meta name="keywords" content="GameCorner, boardgames Romania, boardgames, jocuri de societate, jocuri in familie">
   <%- include('../fragmente/head.ejs') %>

</head>

<body>
    <link rel="stylesheet" type="text/css" href="/resurse/css/video.css">
    <%- include('../fragmente/header.ejs') %>
    <main>
        <section id="sectiune-video">
            <div id="text">
                Prezentare GameCorner
                <div id="text-reflectat">Prezentare GameCorner</div>
            </div>
            <br>
            <!-- preloaded - cerinta 1 video-tt -->
            <video id="video-vtt" poster="/resurse/imagini/poster-video.png" controls preload="metadata">
                <source src="/resurse/video/clip-prezentare.mp4" type="video/mp4">
                <source src="/resurse/video/clip-prezentare.webm" type="video/webm">
                
                <track src="/resurse/video/tracks/sub_ro.vtt" kind="subtitles" srclang="ro" label="Română" default>
                <track src="/resurse/video/tracks/sub_en.vtt" kind="subtitles" srclang="en" label="English">
                Browserul tău nu suportă tag-ul video.
            </video>
        </section>
    </main>
    <%- include('../fragmente/footer.ejs') %>
</body>

</html>
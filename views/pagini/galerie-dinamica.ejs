<!DOCTYPE html>
<html lang="ro">
<head>
    <%- include('../fragmente/head.ejs') %>
    <link rel="stylesheet" href="/galerie-animata.css?v=<%- nrImagini %>">
    <title>Galerie Jocuri Animata </title>
</head>
<body>
    <%- include('../fragmente/header.ejs') %>

    <main>
        <section class="container mt-5">
            <h1 class="text-center">Galerie Animata</h1>
            <p class="text-center">Descoperă jocurile noastre.</p>

            <div class="galerie-a"> 
                
                <div id="galerie-animata" style="--n: <%- nGrid %>;">
                    
                    <% for(let imag of imaginiAnimatie){ %>
                        <figure>
                            <picture>
                                <source srcset="<%- imag.fisier_mediu %>" media="(max-width:1000px)">
                                <img src="<%- imag.fisier %>" alt="imagine">
                            </picture>

                            <figcaption>
                                <%- imag.nume %> 
                            </figcaption>
                        </figure>
                    <% } %>
                    
                </div>
            </div>
            
            <%- include('../fragmente/galerie.ejs') %>
        </section>
    </main>

    <%- include('../fragmente/footer.ejs') %>
    
</body>
</html>